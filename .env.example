# Phase 3 configuration — copy to .env and fill in values
# This file is read-only by agents — never modified during execution

# Local fork paths (absolute)
DEVELOPER_IMAGES_PATH=/home/user/developer-images
AI_LAB_TEMPLATE_PATH=/home/user/ai-lab-template

# Quay.io namespaces
QUAY_PERSONAL_NS=your-quay-username
QUAY_OFFICIAL_NS=redhat-ai-dev

# GitHub fork owner (for PRs from fork)
FORK_OWNER=your-github-username

# Rolling demo repo (for Phase 4 ROSA deployment)
ROLLING_DEMO_GITOPS_PATH=/home/user/ai-rolling-demo-gitops

# ROSA cluster (for template testing)
CLUSTER_API=https://api.rosa-xxx.openshiftapps.com:6443
CLUSTER_TOKEN=sha256:xxx
